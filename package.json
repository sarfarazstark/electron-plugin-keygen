{
	"name": "electron-plugin-keygen",
	"version": "1.0.0",
	"description": "Keygen.sh licensing for Electron — a port of tauri-plugin-keygen (v2)",
	"license": "MIT",
	"type": "module",
	"main": "./dist/main/index.js",
	"types": "./dist/main/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/main/index.d.ts",
			"import": "./dist/main/index.js"
		},
		"./preload": {
			"types": "./dist/preload/index.d.ts",
			"import": "./dist/preload/index.mjs"
		},
		"./preload/api": {
			"types": "./dist/preload/api.d.ts",
			"import": "./dist/preload/api.js"
		},
		"./renderer": {
			"types": "./dist/renderer/index.d.ts",
			"import": "./dist/renderer/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "npm run build:lib && npm --prefix example run build",
		"build:lib": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
		"dev": "npm --prefix example run dev",
		"start": "npm --prefix example run start",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && npm --prefix example run typecheck",
		"lint": "biome check .",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"valibot": "^1.3.5"
	},
	"peerDependencies": {
		"electron": ">=30"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"@types/node": "^26.6.6",
		"electron": "^45.2.2",
		"electron-vite": "^6.0.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5"
	}
}
