{
	"$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
	"files": {
		"includes": [
			"lib/**",
			"tests/**",
			"scripts/**",
			"example/src/**",
			"example/electron.vite.config.ts",
			"example/package.json",
			"package.json",
			"!tauri",
			"!dist",
			"!out",
			"!example/out",
			"!node_modules",
			"!example/node_modules"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 110
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"enabled": false
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	}
}
